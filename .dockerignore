.git
.gitignore
.github
.next
node_modules
npm-debug.log*
tsconfig.tsbuildinfo
next-env.d.ts
.env*
!.env.example

# Not needed to build the image. Keeping them out trims the build context and
# stops the builder from copying seed photos, test suites, and docs it never
# reads.
tests
coverage
docs
reference
seed
# The build runs the prerender guard, so keep that one file in the context.
scripts/*
!scripts/check-prerender.mjs
.icon-build
**/*.md
vitest.config.mts
eslint.config.mjs
