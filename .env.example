# Convex deployment used by the Next.js app and server actions.
# Server-side Convex URL. Keeps the deployment address out of the client bundle.
CONVEX_URL=

# Public Convex URL used by the browser client.
NEXT_PUBLIC_CONVEX_URL=

# Convex HTTP actions / Better Auth site URL. Ends in .convex.site on Convex Cloud.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Better Auth origin (the public Next.js origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Written by `npx convex dev` after you sign in and select a project.
# Leave empty unless you are targeting a specific deployment.
CONVEX_DEPLOYMENT=

# Development-only workspace preview when Convex is absent.
# Never set this in production. Production requires a real session.
# NEXT_PUBLIC_WORKSPACE_PREVIEW=1

# Set these on the Convex deployment, not in this file:
#   npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
#   npx convex env set SITE_URL http://localhost:3000
# Never commit real secrets.
