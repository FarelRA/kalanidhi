# Convex deployment used by the Next.js app and server actions.
# Server-side Convex URL. Keeps the deployment address out of the client bundle.
CONVEX_URL=

# Optional public alias used by the Convex React client.
NEXT_PUBLIC_CONVEX_URL=

# Written by `npx convex dev` after you sign in and select a project.
# Leave empty unless you are targeting a specific deployment.
CONVEX_DEPLOYMENT=
